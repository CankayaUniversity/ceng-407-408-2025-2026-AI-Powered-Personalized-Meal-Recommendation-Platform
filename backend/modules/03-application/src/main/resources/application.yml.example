server:
  port: 8081

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8080/realms/meal-app-realm}
          jwk-set-uri: ${KEYCLOAK_JWK_SET_URI:http://keycloak-auth:8080/realms/meal-app-realm/protocol/openid-connect/certs}
  # Keycloak configuration

  jackson:
    deserialization:
      accept-empty-string-as-null-object: true

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

  datasource:
    # Docker ortamı için DB_HOST ve DB_PORT değişkenleri kullanılır.
    # Varsayılan (localhost:5432) ayarlar yerel geliştirme içindir.
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/meal_app_db
    username: ${SPRING_DATASOURCE_USERNAME:postgres}
    password: ${SPRING_DATASOURCE_PASSWORD:postgres} # Buraya kendi şifrenizi yazınız
    driver-class-name: org.postgresql.Driver
  
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: false
        default_batch_fetch_size: 100 # N+1 problemini çözmek için batch fetch kullanıyoruz

  cache:
    type: caffeine
    caffeine:
      spec: expireAfterWrite=1h,maximumSize=500

  flyway:
    enabled: true
    repair-on-migrate: true
    baseline-on-migrate: true
    clean-on-validation-error: false
    clean-disabled: true
    locations: classpath:db/migration

com:
  mealapp:
    ai:
      provider-type: ${AI_PROVIDER_TYPE:OPENAI} # OPENAI, GEMINI, CLAUDE, MISTRAL, DEEPSEEK vb.
      service:
        openai:
          api-key: ${OPENAI_API_KEY:your-key-here}
          model: ${OPENAI_MODEL:gpt-4o-mini}
          url: ${OPENAI_URL:https://api.openai.com/v1/chat/completions}
        gemini:
          api-key: ${GEMINI_API_KEY:your-key-here}
          model: ${GEMINI_MODEL:gemini-1.5-flash}
          url: ${GEMINI_URL:https://generativelanguage.googleapis.com/v1beta/models/}
        claude:
          api-key: ${CLAUDE_API_KEY:your-key-here}
          model: ${CLAUDE_MODEL:claude-3-5-sonnet-20240620}
          url: ${CLAUDE_URL:https://api.anthropic.com/v1/messages}
          anthropic-version: ${ANTHROPIC_VERSION:2023-06-01}
        generic:
          api-key: ${GENERIC_AI_API_KEY:your-key-here}
          model: ${GENERIC_AI_MODEL:default-model}
          url: ${GENERIC_AI_URL:http://localhost:8080/v1/chat/completions}
          provider-name: ${GENERIC_AI_PROVIDER_NAME:GENERIC}
    infrastructure:
      storage:
        bucket:
          name: meal-app-bucket
        minio:
          # Sunucu tarafı erişim (örn Docker ağı içi): http://minio-server:9000
          endpoint: ${MINIO_ENDPOINT:http://localhost:9000}
          # İstemci tarafı erişim (tarayıcıdan erişim): http://localhost:9000
          external-endpoint: ${MINIO_EXTERNAL_ENDPOINT:http://localhost:9000}
          access-key: ${MINIO_ACCESS_KEY:minioadmin}
          secret-key: ${MINIO_SECRET_KEY:minioadmin}

logging:
  level:
    org.hibernate.SQL: DEBUG
    org.hibernate.type.descriptor.sql.BasicBinder: TRACE
    org.springframework.security: DEBUG
    org.springframework.security.oauth2: DEBUG
